# build output
/bin/
/dist/

# frontend build artifacts (embedded at build time, not committed)
/web/node_modules/
/web/dist/

# local state: profiles DB, config, sealed credentials
*.db
*.db-shm
*.db-wal
/rcon-ui.yaml

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Built frontend: generated by `make ui`, embedded at build time.
# The .gitkeep placeholder is committed so go:embed still resolves on a
# fresh clone that has not built the UI yet.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# TypeScript incremental build state
web/*.tsbuildinfo
